<?php

namespace App\Http\Resources\V1\{{Feature}}\Public;

use Illuminate\Http\Request;
use Illuminate\Http\Resources\Json\JsonResource;

class Public{{Feature}}Resource extends JsonResource
{
    public function toArray(Request $request): array
    {
        return [
            'id' => $this->id,
            'slug' => $this->slug,
            'title' => $this->title,
            'description' => $this->description,
            // Only expose fields that are intended to be public.
        ];
    }
}
